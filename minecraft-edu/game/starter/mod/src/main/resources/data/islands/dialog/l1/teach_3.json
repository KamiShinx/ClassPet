{
  "type": "minecraft:multi_action",
  "title": {
    "text": "מאפיין חיים: נשימה",
    "color": "gold"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "הצפרדע נושמת אוויר. הדג נושם בזימים את החמצן שמומס במים."
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "כל יצור חי נושם, גם צמחים. בנשימה הגוף מפיק אנרגיה מהמזון."
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "מתייגים כאן: צפרדע ודג סלמון.",
        "color": "gray"
      },
      "width": 300
    }
  ],
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "a",
      "label": {
        "text": "איך דג נושם מתחת למים?"
      },
      "width": 300,
      "options": [
        {
          "id": "1",
          "display": {
            "text": "הוא לא נושם בכלל"
          },
          "initial": true
        },
        {
          "id": "2",
          "display": {
            "text": "הוא עולה לנשום אוויר כל דקה"
          }
        },
        {
          "id": "3",
          "display": {
            "text": "בזימים, את החמצן שבמים"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "label": {
        "text": "זאת התשובה שלי"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "trigger islands_act set 33$(a)"
      }
    }
  ],
  "columns": 1
}

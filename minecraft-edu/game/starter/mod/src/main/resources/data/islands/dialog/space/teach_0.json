{
  "type": "minecraft:multi_action",
  "title": {
    "text": "תחנה 1: ערפילית",
    "color": "gold"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "זו ערפילית: ענן ענק של גז ואבק בחלל. רוב הגז הוא מימן."
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "כאן נולדים כוכבים. כוח המשיכה מושך חלקים של הענן זה אל זה, והם נעשים צפופים יותר ויותר."
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "באנגלית: ",
          "color": "gray"
        },
        {
          "text": "Nebula",
          "color": "aqua",
          "bold": true
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "הנקודות הלבנות בתוך הענן הן כוכבים חדשים.",
        "color": "gray"
      },
      "width": 300
    }
  ],
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "a",
      "label": {
        "text": "מה יש בערפילית?"
      },
      "width": 300,
      "options": [
        {
          "id": "1",
          "display": {
            "text": "גז ואבק"
          },
          "initial": true
        },
        {
          "id": "2",
          "display": {
            "text": "מים וקרח"
          }
        },
        {
          "id": "3",
          "display": {
            "text": "סלעים וחול"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "label": {
        "text": "זאת התשובה שלי"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "trigger islands_act set 50$(a)"
      }
    }
  ],
  "columns": 1
